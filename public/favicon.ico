<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <!-- Gradients -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFF176"/>
      <stop offset="30%" stop-color="#F59E0B"/>
      <stop offset="70%" stop-color="#D97706"/>
      <stop offset="100%" stop-color="#78350F"/>
    </linearGradient>

    <linearGradient id="blueGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#0284C7"/>
      <stop offset="50%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#1D4ED8"/>
    </linearGradient>

    <linearGradient id="cyanGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </linearGradient>

    <linearGradient id="irisGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F172A"/>
      <stop offset="50%" stop-color="#1E293B"/>
      <stop offset="100%" stop-color="#030712"/>
    </linearGradient>

    <!-- Glow Filters -->
    <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="5" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
    <filter id="cyanGlow" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <g transform="translate(0, 10)">
    <!-- 1. SUNBURST RAYS (TOP) -->
    <g id="sunburst" filter="url(#goldGlow)">
      <!-- Central Sun Disc -->
      <path d="M 330 140 A 70 70 0 0 1 470 140 Z" fill="url(#goldGrad)"/>
      <path d="M 345 140 A 55 55 0 0 1 455 140 Z" fill="#FFF176" opacity="0.9"/>
      
      <!-- Rays -->
      <line x1="400" y1="65" x2="400" y2="25" stroke="url(#goldGrad)" stroke-width="8" stroke-linecap="round"/>
      <line x1="365" y1="72" x2="345" y2="35" stroke="url(#goldGrad)" stroke-width="7" stroke-linecap="round"/>
      <line x1="435" y1="72" x2="455" y2="35" stroke="url(#goldGrad)" stroke-width="7" stroke-linecap="round"/>
      <line x1="332" y1="90" x2="295" y2="60" stroke="url(#goldGrad)" stroke-width="6" stroke-linecap="round"/>
      <line x1="468" y1="90" x2="505" y2="60" stroke="url(#goldGrad)" stroke-width="6" stroke-linecap="round"/>
      <line x1="305" y1="118" x2="255" y2="98" stroke="url(#goldGrad)" stroke-width="5" stroke-linecap="round"/>
      <line x1="495" y1="118" x2="545" y2="98" stroke="url(#goldGrad)" stroke-width="5" stroke-linecap="round"/>
      <line x1="288" y1="148" x2="230" y2="140" stroke="url(#goldGrad)" stroke-width="4" stroke-linecap="round"/>
      <line x1="512" y1="148" x2="570" y2="140" stroke="url(#goldGrad)" stroke-width="4" stroke-linecap="round"/>

      <!-- Interspersed small rays -->
      <line x1="382" y1="67" x2="375" y2="40" stroke="#FFF176" stroke-width="4" stroke-linecap="round"/>
      <line x1="418" y1="67" x2="425" y2="40" stroke="#FFF176" stroke-width="4" stroke-linecap="round"/>
      <line x1="348" y1="80" x2="322" y2="48" stroke="#FFF176" stroke-width="4" stroke-linecap="round"/>
      <line x1="452" y1="80" x2="478" y2="48" stroke="#FFF176" stroke-width="4" stroke-linecap="round"/>
    </g>

    <!-- 2. CIRCUIT BRANCHES (LEFT SIDE) -->
    <g id="circuits" stroke="url(#cyanGrad)" fill="none" stroke-linecap="round">
      <path d="M 270 170 Q 210 160 160 170 T 110 165" stroke-width="4"/>
      <circle cx="106" cy="165" r="5" fill="#38BDF8" stroke="#0284C7" stroke-width="2"/>

      <path d="M 230 195 L 170 195 L 140 215 L 90 215" stroke-width="4"/>
      <circle cx="85" cy="215" r="6" fill="#38BDF8" stroke="#0284C7" stroke-width="2"/>

      <path d="M 210 225 L 170 240 L 130 240 L 105 270 L 70 270" stroke-width="4"/>
      <circle cx="65" cy="270" r="5" fill="#38BDF8" stroke="#0284C7" stroke-width="2"/>

      <path d="M 240 255 L 200 285 L 160 285 L 135 315 L 100 315" stroke-width="3"/>
      <circle cx="95" cy="315" r="4" fill="#F59E0B" stroke="#D97706" stroke-width="2"/>

      <!-- Digital Tech Pixels / Cubes -->
      <rect x="180" y="145" width="10" height="10" fill="#38BDF8" rx="2" />
      <rect x="195" y="135" width="8" height="8" fill="#0284C7" rx="1.5" />
      <rect x="210" y="150" width="12" height="12" fill="#38BDF8" rx="2" />
      <rect x="165" y="210" width="9" height="9" fill="#F59E0B" rx="1.5" />
      <rect x="180" y="225" width="11" height="11" fill="#38BDF8" rx="2" />
      <rect x="150" y="255" width="8" height="8" fill="#818CF8" rx="1.5" />
      <rect x="130" y="275" width="10" height="10" fill="#C084FC" rx="2" />
    </g>

    <!-- 3. EYE OF RA MAIN STRUCTURE -->
    <g id="eye-structure">
      <!-- Upper Eyebrow Gold Arch -->
      <path d="M 230 180 C 310 110 490 110 570 180 C 490 135 310 135 230 180 Z" fill="url(#goldGrad)" />
      
      <!-- Middle Blue Band -->
      <path d="M 235 185 C 310 140 490 140 565 185 C 490 160 310 160 235 185 Z" fill="url(#blueGrad)" />

      <!-- Upper Eyelid Main Gold Arch -->
      <path d="M 200 230 C 270 145 530 145 600 230 C 530 170 270 170 200 230 Z" fill="url(#goldGrad)" filter="url(#goldGlow)"/>

      <!-- Lower Eyelid Gold Arch -->
      <path d="M 200 230 C 270 310 530 310 600 230 C 530 280 270 280 200 230 Z" fill="url(#goldGrad)"/>

      <!-- Eye Corner Extensions -->
      <!-- Right Tear Duct Wing -->
      <path d="M 600 230 C 620 220 640 215 655 220 C 635 235 615 240 600 230 Z" fill="url(#goldGrad)"/>

      <!-- Bottom Classic Spiral Hook -->
      <path d="M 330 280 C 300 330 280 370 310 395 C 335 415 365 390 345 365 C 330 350 315 365 325 375 C 330 380 338 375 332 370" fill="none" stroke="url(#goldGrad)" stroke-width="12" stroke-linecap="round"/>

      <!-- Bottom Vertical Teardrop Line -->
      <path d="M 500 270 L 500 370 L 482 370 L 482 270 Z" fill="url(#blueGrad)" stroke="url(#goldGrad)" stroke-width="2"/>
    </g>

    <!-- 4. IRIS & CODE BRACKETS </ > -->
    <g id="iris" filter="url(#cyanGlow)">
      <!-- Iris Background Circle -->
      <circle cx="400" cy="230" r="68" fill="url(#irisGrad)" stroke="url(#goldGrad)" stroke-width="7"/>
      <circle cx="400" cy="230" r="60" fill="none" stroke="#38BDF8" stroke-width="2.5" opacity="0.8"/>

      <!-- Code Symbol: < / > inside Iris -->
      <!-- Left Angle Bracket < -->
      <path d="M 372 215 L 354 230 L 372 245" fill="none" stroke="#38BDF8" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
      
      <!-- Slash / -->
      <path d="M 406 208 L 394 252" fill="none" stroke="#F59E0B" stroke-width="7" stroke-linecap="round"/>

      <!-- Right Angle Bracket > -->
      <path d="M 428 215 L 446 230 L 428 245" fill="none" stroke="#38BDF8" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
    </g>

    <!-- 5. TYPOGRAPHY & BRAND NAME -->
    <g id="brand-text" text-anchor="middle">
      <!-- CODE RA Text -->
      <text x="400" y="475" font-family="'Inter', 'Cairo', 'Arial Black', sans-serif" font-size="78" font-weight="900" letter-spacing="6">
        <tspan fill="#334155">CODE</tspan>
        <tspan fill="url(#cyanGrad)"> </tspan>
        <tspan fill="url(#goldGrad)">RA</tspan>
      </text>

      <!-- Subtitle: CODE • EMPOWER • SHINE -->
      <text x="400" y="520" font-family="'Inter', 'Cairo', sans-serif" font-size="22" font-weight="800" fill="#64748B" letter-spacing="10">
        CODE <tspan fill="#F59E0B">•</tspan> EMPOWER <tspan fill="#0284C7">•</tspan> SHINE
      </text>

      <!-- Bottom Tagline: INCLUSIVE CODING FOR EVERY MIND -->
      <g transform="translate(0, 555)">
        <text x="400" y="0" font-family="'Inter', 'Cairo', sans-serif" font-size="15" font-weight="700" letter-spacing="3">
          <tspan fill="#F59E0B" font-size="18">&lt;</tspan>
          <tspan fill="#94A3B8"> — </tspan>
          <tspan fill="#475569">INCLUSIVE </tspan>
          <tspan fill="#0284C7">CODING </tspan>
          <tspan fill="#475569">FOR EVERY MIND</tspan>
          <tspan fill="#94A3B8"> — </tspan>
          <tspan fill="#0284C7" font-size="18">/&gt;</tspan>
        </text>
      </g>
    </g>
  </g>
</svg>
